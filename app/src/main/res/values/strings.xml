    <string name="guide_autostart_switch">Start camera after phone reboot</string>
    <string name="guide_overlay_perm">"Display over other apps" permission</string>
    <string name="guide_overlay_hint">Without it, after reboot a notification will appear - you can start the camera with one tap. Better to disable screen lock.</string>
