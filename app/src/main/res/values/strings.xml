    <string name="guide_allow">Allow</string>
    <string name="guide_step_background">Background operation</string>
    <string name="guide_battery_perm">No battery restrictions</string>
    <string name="guide_samsung_hint">Samsung: Settings > Apps > Surveillance Camera > Battery - select "Unrestricted". In "Device care > Auto optimize" disable scheduled restart - or enable autostart below.</string>
    <string name="guide_xiaomi_hint">Xiaomi: In app settings, enable "Autostart" and "Activity controls: No restrictions".</string>
    <string name="guide_huawei_hint">Huawei/Honor: "App launch" - switch to manual and allow background activity.</string>
    <string name="guide_open_settings">Open app settings</string>
    <string name="guide_charging_hint">Keep the phone plugged in: camera and Wi-Fi run continuously.</string>
    <string name="guide_step_connect">Connect from another device</string>
    <string name="guide_connect_text">1. Connect this phone and your computer (or another phone) to the same Wi-Fi network.
2. Open the address below in a browser - or scan the QR code.
3. To keep the address stable, reserve an IP for this phone in your router settings (DHCP reservation).</string>
    <string name="guide_internet_hint">Internet access: install a VPN (e.g., Tailscale or ZeroTier) on this phone and the device you watch from - the VPN address will appear in the list. Do not open a port on your router without a password.</string>
