    <string name="guide_title">Camera Setup</string>
    <string name="guide_back">Back</string>
    <string name="guide_welcome_title">This phone will become a surveillance camera</string>
    <string name="guide_welcome_text">Real-time H.264 video, motion detection, and video recording. Watch, download recordings, and change settings from a browser on your computer or another phone. You can turn off the screen - the camera will keep working.</string>
    <string name="guide_step_permissions">Permissions</string>
